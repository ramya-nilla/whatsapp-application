<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>WhatsApp Payment</title>
    <style>
        body {
            font-family: Arial, sans-serif;
            background-color: #e5ddd5;
            margin: 0;
            padding: 0;
        }
        .container {
            width: 400px;
            margin: 50px auto;
            background-color: #ffffff;
            border-radius: 10px;
            box-shadow: 0 0 10px rgba(0, 0, 0, 0.1);
            padding: 20px;
        }
        h2 {
            text-align: center;
            color: #25D366;
        }
        .input-group {
            margin: 15px 0;
        }
        .input-group label {
            display: block;
            margin-bottom: 5px;
        }
        .input-group input {
            width: 100%;
            padding: 10px;
            border: 1px solid #ccc;
            border-radius: 5px;
        }
        .button {
            background-color: #25D366;
            color: white;
            border: none;
            padding: 10px;
            border-radius: 5px;
            cursor: pointer;
            width: 100%;
        }
        .button:hover {
            background-color: #128C7E;
        }
    </style>
</head>
<body>
    <div class="container">
        <h2>WhatsApp Payment</h2>
        <div class="input-group">
            <label for="amount">Amount</label>
            <input type="number" id="amount" placeholder="Enter amount" required>
        </div>
        <div class="input-group">
            <label for="recipient">Recipient</label>
            <input type="text" id="recipient" placeholder="Enter recipient's number" required>
        </div>
        <button class="button" onclick="makePayment()">Pay</button>
    </div>

    <script>
        function makePayment() {
            const amount = document.getElementById('amount').value;
            const recipient = document.getElementById('recipient').value;

            if (amount && recipient) {
                alert(`Payment of $${amount} sent to ${recipient}`);
            } else {
                alert('Please fill in all fields');
            }
        }
    </script>
</body>
</html>

